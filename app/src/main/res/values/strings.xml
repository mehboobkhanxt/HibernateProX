    <!-- Accessibility Service & Prominent Disclosure -->
    <string name="accessibility_service_label">HibernatePro X Stop Engine</string>
    <string name="accessibility_service_summary">Detects active foreground app switches and automates tapping Force Stop on System App Info.</string>
    <string name="accessibility_service_description">HibernatePro X uses Accessibility solely to observe foreground app package switches and tap the Force Stop and confirmation buttons inside your device\'s System App Info screen when you trigger hibernation. It never reads or transmits personal screen text, passwords, or messages.</string>
    <string name="disclosure_title">Accessibility Service Disclosure</string>
    <string name="disclosure_body">HibernatePro X requests the Android AccessibilityService permission for two strictly on-device tasks:\n\n1. Detect foreground app changes (package name only) so you can see which app is active and exclude it from auto-stop.\n2. Automate tapping \"Force stop\" and its confirmation dialog inside System Settings &gt; App Info when you tap Force Stop or Hibernate All.\n\nPrivacy Guarantee: HibernatePro X never inspects screen content outside System Settings, never records keystrokes, and has zero internet permission.</string>
    <string name="disclosure_accept">Agree &amp; Open Settings</string>
    <string name="disclosure_decline">Not Now</string>
